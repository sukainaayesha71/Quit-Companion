SITE_DOMAIN=your-api-domain.example
FIREBASE_CREDENTIAL_FILE=/absolute/host/path/to/firebase-credentials.json
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
FCM_SCHEDULER_TOKEN=
# Relapse risk scoring. The code default is "ml" (packaged XGBoost pipeline,
# experimental, not clinically validated, falls back to rule_based if the
# artifact can't load). This template keeps the conservative SRDS rule table
# for production; switch to ml only as a deliberate decision.
RELAPSE_PREDICTOR_MODE=rule_based
# With ml: true = refuse to start if the model can't load (default false).
# RELAPSE_MODEL_REQUIRED=false
# Optional mounted artifact instead of the packaged copy.
# RELAPSE_MODEL_PATH=
# Health-Bot: seconds Gemini gets before the curated fallback is used (FR8).
HEALTHBOT_GEMINI_TIMEOUT_SECONDS=1.5
WORKER_POLL_SECONDS=30
# Enable only with an actual advisor approval record mounted into both services.
# While true and no approved record exists, non-emergency Health-Bot questions
# get HTTP 503 (the app shows its curated fallback) and /ready reports 503.
REQUIRE_CLINICAL_REVIEW=true
CLINICAL_REVIEW_RECORD=/run/reviews/clinical-review.json
