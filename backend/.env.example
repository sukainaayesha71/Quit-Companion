# Copy to .env for a new installation; never commit actual secrets.
# Run backend commands from backend/ so relative paths resolve correctly.
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-serviceAccount.json
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
RELAPSE_PREDICTOR_MODE=ml
WORKER_POLL_SECONDS=30

# Optional Meta WhatsApp OTP configuration (required for real-number routing).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v27.0
WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en_US

# Optional authenticated scheduler integration; not needed by app.worker.
FCM_SCHEDULER_TOKEN=
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_VERIFY_ATTEMPTS=5

# Local development only; production needs a genuine advisor review record.
REQUIRE_CLINICAL_REVIEW=false
# CLINICAL_REVIEW_RECORD=/path/to/approved-review.json
